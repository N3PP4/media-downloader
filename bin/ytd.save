#!/bin/zsh

clear

echo "========================="
echo "📥 Media Downloader"
echo "========================="
echo

echo "1) Best Quality"
echo "2) MP3"
echo "3) Settings"
echo "0) Exit"
echo

read "choice?番号を選んでください > "

echo

case "$choice" in
    1)
        read "url?URL > "

        echo
        echo "Downloading..."
        yt-dlp "$url"
        ;;

    2)
        echo "🎵 MP3 mode selected."
        ;;

    3)
        echo "⚙️ Settings selected."
        ;;

    0)
        echo "👋 Goodbye!"
        ;;

    *)
        echo "❌ Invalid selection."
        ;;
esac1)
    echo
    read "url?URL > "

    echo
    echo "Downloading..."
    yt-dlp "$url"
    ;;#!/bin/zsh

clear

echo "========================="
echo "📥 Media Downloader"
echo "========================="
echo

echo "1) Best Quality"
echo "2) MP3"
echo "3) Settings"
echo "0) Exit"
echo

read "choice?番号を選んでください > "

echo

if [[ "$choice" == "1" ]]; then
    echo "🎥 Best Quality mode selected."

elif [[ "$choice" == "2" ]]; then
    echo "🎵 MP3 mode selected."

elif [[ "$choice" == "3" ]]; then
    echo "⚙️ Settings selected."

elif [[ "$choice" == "0" ]]; then
    echo "👋 Goodbye!"

else
    echo "❌ Invalid selection."
fi
