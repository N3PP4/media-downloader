#!/bin/zsh

clear

echo "========================="
echo "📥 Media Downloader"
echo "========================="
echo

echo "1) Best Quality"
echo "2) MP3"
echo "3) Settings"
echo "0) Exit"
echo

read "choice?番号を選んでください > "

echo

case "$choice" in
    1)
                clipboard=$(pbpaste)

        if [[ "$clipboard" == http* ]]; then
            echo "📋 URL found in clipboard:"
            echo
            echo "$clipboard"
            echo
            read "url?Press Enter to use it or paste another URL > "

            if [[ -z "$url" ]]; then
                url="$clipboard"
            fi
        else
            read "url?URL > "
        fi

        echo
        echo "Downloading..."
        yt-dlp \
            -f "bv*+ba/b" \
            --merge-output-format mp4 \
            --embed-metadata \
            --no-update \
            "$url"
        ;;

    2)
        echo "🎵 MP3 mode selected."
        ;;

    3)
        echo "⚙️ Settings selected."
        ;;

    0)
        echo "👋 Goodbye!"
        ;;

    *)
        echo "❌ Invalid selection."
        ;;
esac
